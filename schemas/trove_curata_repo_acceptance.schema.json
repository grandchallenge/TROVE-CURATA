{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/trove_curata_repo_acceptance.schema.json",
  "title": "TROVE-CURATA repository bootstrap acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_id",
    "status",
    "source",
    "destination",
    "imported_artifact_count",
    "imported_artifacts",
    "imported_mapping_sha256",
    "bootstrap_roots",
    "review_remedies",
    "replay_contract",
    "activation_contract",
    "operating_authority",
    "authority_boundary",
    "claim_boundary",
    "acceptance_record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "acceptance_id": {"const": "TC-REPO-ACCEPT-001"},
    "status": {"const": "prepared_pending_destination_protected_merge_and_two_sided_readback"},
    "source": {"type": "object"},
    "destination": {"type": "object"},
    "imported_artifact_count": {"const": 92},
    "imported_artifacts": {
      "type": "array",
      "minItems": 92,
      "maxItems": 92,
      "items": {"$ref": "#/$defs/importedArtifact"}
    },
    "imported_mapping_sha256": {"$ref": "#/$defs/sha256"},
    "bootstrap_roots": {"type": "object"},
    "review_remedies": {"type": "object"},
    "replay_contract": {"type": "object"},
    "activation_contract": {"type": "object"},
    "operating_authority": {"$ref": "#/$defs/operatingAuthority"},
    "authority_boundary": {"type": "object"},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 18,
      "maxProperties": 18
    },
    "acceptance_record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operatingAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "protected_head",
        "schedule_path",
        "schedule_blob_sha",
        "schedule_schema_version",
        "directive_id",
        "directive_path",
        "directive_blob_sha",
        "ordinary_human_steward",
        "recovery_owner",
        "mandatory_routine_reviewers",
        "human_actions_per_governed_decision_target",
        "non_author_agent_adversary_required",
        "distinct_non_author_agent_referee_required",
        "distinct_agent_sessions_required",
        "github_approval_is_human_steward_authorization",
        "mechanical_merge_is_human_steward_authorization",
        "recovery_owner_required_for_routine_merge",
        "agent_may_merge_own_work"
      ],
      "properties": {
        "repository": {"const": "grandchallenge/INTELLECT"},
        "protected_head": {"const": "041f7d9b1c85e157a651bcf3edf07c7499185b00"},
        "schedule_path": {"const": "governance/constitutional_authority_schedule.json"},
        "schedule_blob_sha": {"const": "6f66ed27ed7ff2889e4dd67c34973c8fa2f798a8"},
        "schedule_schema_version": {"const": "1.5.0"},
        "directive_id": {"const": "GI-STEWARD-0002"},
        "directive_path": {"const": "governance/steward_directives/GI-STEWARD-0002.md"},
        "directive_blob_sha": {"const": "9c70ad6b9c0100ab571a59605de0531c23cd25d6"},
        "ordinary_human_steward": {"const": "fyremael"},
        "recovery_owner": {"const": "jimsteeg"},
        "mandatory_routine_reviewers": {"type": "array", "maxItems": 0},
        "human_actions_per_governed_decision_target": {"const": 1},
        "non_author_agent_adversary_required": {"const": true},
        "distinct_non_author_agent_referee_required": {"const": true},
        "distinct_agent_sessions_required": {"const": true},
        "github_approval_is_human_steward_authorization": {"const": false},
        "mechanical_merge_is_human_steward_authorization": {"const": false},
        "recovery_owner_required_for_routine_merge": {"const": false},
        "agent_may_merge_own_work": {"const": false}
      }
    },
    "importedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "destination_path", "blob_sha", "size"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "destination_path": {"type": "string", "pattern": "^bootstrap/intellect-snapshot/"},
        "blob_sha": {"$ref": "#/$defs/gitSha"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
